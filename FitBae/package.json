{
  "name": "fitbae",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:mobile": "vite build --mode mobile",
    "android:sync": "npm run build:mobile && node scripts/verify-mobile-build.mjs && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && node scripts/build-android.mjs",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "lint": "eslint src api scripts tests e2e *.js --max-warnings=0",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
