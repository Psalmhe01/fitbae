# Browser configuration (the Supabase anonymous key is designed for clients;
# protect data with Row Level Security policies).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Native builds use the public VITE_API_BASE_URL from .env.mobile. The website
# continues to call its own /api/generate-plan endpoint.

# Server-only workout generation configuration. Never prefix this key with
# VITE_ in production or commit a real value.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Server-side session verification. These may match the public Supabase values
# above, but keeping server names separate makes deployment intent explicit.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Optional local administration only. Never use VITE_ prefixes for these values.
# Session pooler (port 5432) works from IPv4 networks. URL-encode the DB password.
# SUPABASE_DB_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# SUPABASE_SERVICE_ROLE_KEY=
# Test passwords belong in the ignored .env.test-accounts.local, not this file.

# Local Vite-only compatibility fallback. This exposes the key in browser code,
# so leave it unset unless you explicitly accept that risk during local work.
# VITE_GEMINI_API_KEY=
